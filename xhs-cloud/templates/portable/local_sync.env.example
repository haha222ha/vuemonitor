# 复制到 D:\xhs-data\config\local_sync.env 并填写密钥
# 所有路径固定为 D 盘移动硬盘，换电脑勿改（除非盘符变化，见 portable_paths.env）

XHS_PORTABLE_ROOT=D:\
XHS_CLOUD_PKG_ROOT=D:\vuemonitor\xhs-cloud
XHS_CLOUD_API_URL=https://monitor.xhs365.cn
XHS_CLOUD_SYNC_KEY=请填与云服务器一致

XHS_CRAWLER_ROOT=D:\0622小红薯备份\jiekoufenxi\小红书多设备爬虫
XHS_PREMIUM_DB=D:\0622小红薯备份\jiekoufenxi\小红书多设备爬虫\crawl_data\premium_goods.db
XHS_MAIN_DB=D:\0622小红薯备份\jiekoufenxi\小红书多设备爬虫\crawl_data\xhs_burst_monitor.db
XHS_KEYWORD_DIR=D:\关键词搜索
XHS_REPORT_DIR=D:\选品报告

XHS_SYNC_CLIENT_ID=local_app:YOUR_PC_NAME
XHS_SYNC_INTERVAL_SEC=300
XHS_SYNC_LOG_DIR=D:\xhs-data\logs
XHS_LOCAL_AGENT_LOG_DIR=D:\xhs-data\logs
XHS_LOCAL_AGENT_ENV=D:\xhs-data\config\local_sync.env

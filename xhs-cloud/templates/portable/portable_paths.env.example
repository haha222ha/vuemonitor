# 复制到 D:\xhs-data\config\portable_paths.env 并填写
#
# 盘符变化时改 XHS_PORTABLE_ROOT；爬虫位置因机器而异，必须填写 XHS_CRAWLER_ROOT。

XHS_PORTABLE_ROOT=D:\
XHS_CRAWLER_ROOT=D:\你的路径\小红书多设备爬虫

# 可选：若与默认推导不同可显式指定（一般留空，由脚本拼接）
# XHS_MAIN_DB=D:\你的路径\小红书多设备爬虫\crawl_data\xhs_burst_monitor.db
# XHS_PREMIUM_DB=D:\你的路径\小红书多设备爬虫\crawl_data\premium_goods.db

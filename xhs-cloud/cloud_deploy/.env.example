# 复制为 /opt/xhs-cloud/.env
XHS_CLOUD_ROOT=/opt/xhs-cloud
XHS_ENV_FILE=/opt/xhs-cloud/.env
XHS_DATA_DIR=/opt/xhs-cloud/data
XHS_REPORT_INCOMING_DIR=/opt/xhs-cloud/data/incoming
XHS_REPORT_ARCHIVE_DIR=/opt/xhs-cloud/data/report_archives
XHS_CLOUD_API_DB=/opt/xhs-cloud/data/cloud_api.db

# 会员中心网页: http://你的域名/ 或 http://IP:8080/
# 授权码生成: ./venv/bin/python cloud_deploy/scripts/manage_auth_codes.py generate --plan monthly --days 30 --count 5
XHS_CLOUD_HOST=127.0.0.1
XHS_CLOUD_PORT=8080
XHS_CLOUD_SYNC_KEY=change-me-sync-key-long-random
XHS_CLOUD_JWT_SECRET=change-me-jwt-secret-long-random
# 会员登录保持天数（默认 30 天，减少重复登录）
XHS_CLOUD_JWT_TTL_DAYS=30
XHS_CLOUD_ADMIN_USER=admin
XHS_CLOUD_ADMIN_PASS=change-me-admin

# ── hwxun 微信扫码支付（选品会员在线购买）──
# 商户后台：https://pay.hwxun.cn/  回调地址填 https://monitor.xhs365.cn/api/v1/payment/notify/hwxun
XHS_PAY_API_URL=https://pay.hwxun.cn/
XHS_PAY_PID=你的商户PID
XHS_PAY_KEY=你的商户密钥
XHS_PAY_NOTIFY_BASE=https://monitor.xhs365.cn

# 与 vuemonitor 共用 PG 实例，独立 schema xhs_monitor
XHS_DATABASE_URL=postgresql://xhs_monitor_user:你的密码@127.0.0.1:5432/vuemonitor

# 云端 PG 生成报告输出目录（run_full_pipeline generate/full）
# XHS_REPORT_OUTPUT_DIR=/opt/xhs-cloud/data/reports
# HTML 模板（默认 cloud_deploy/assets/index_with_gr.html）
# XHS_HTML_TEMPLATE=/opt/xhs-cloud/cloud_deploy/assets/index_with_gr.html

# 可选：仅 sold_history 一次性回补时挂载本地主库只读路径（日常可不配）
# XHS_DB_PATH=/opt/xhs-cloud/data/xhs_burst_monitor.db

# ── 数据保留（对标成熟选品平台：L1 永久 + L2 快照可配置）──
# L1 永久：report_daily_items / goods_sold_daily / report_archives（年度分析主数据源）
# L2 快照：goods_sold_snapshots（日内扫描轨迹）
#   0 = 永久保留（默认，推荐年度选品积累）
#   90 = 仅保留近 90 天快照（日汇总已在 L1，删快照不影响年报）
XHS_SNAPSHOT_RETENTION_DAYS=0
# XHS_ENABLE_SNAPSHOT_PRUNE=0   # 显式关闭定时清理（retention=0 时自动关闭）

# 云扫描守护（默认 cloud 分层引擎，写 PG；legacy: XHS_DAEMON_MODE=full_sold）
XHS_CRAWLER_ROOT=/opt/xhs/crawler
# 小红书登录 cookie（浏览器 DevTools → Network → 复制 Cookie 头，或写入文件）
# XHS_COOKIE=web_session=...;a1=...;webId=...
# XHS_COOKIE_FILE=/opt/xhs/crawler/crawl_data/xhs_cookie.txt
# XHS_DAEMON_MODE=cloud
# XHS_ENABLE_PLAYWRIGHT=0
# XHS_DAEMON_BATCH_SIZE=1000

# ── 本地 risk Agent（Playwright 补采，HTTP 回传，无需开 PG 5432）──
# 服务器与本地填相同密钥；建议再配 IP 白名单（你家宽带公网 IP）
# XHS_LOCAL_AGENT_KEY=change-me-agent-key-long-random
# XHS_AGENT_IP_ALLOWLIST=你的公网IP
# 云端 API: systemctl enable --now xhs-cloud-api
# 本地安装: powershell -File tools/install_local_risk_agent.ps1 -EnvFile tools/local_agent.env
# XHS_DAEMON_CONCURRENCY=3
# XHS_DAEMON_COOLDOWN_SEC=60
# XHS_PG_SMALL_POOL_THRESHOLD=50000
# XHS_DAEMON_ENGINE=api

# 纯线上全自动（推荐 enable 的 timer）:
#   xhs-daemon.service          — 云扫描写 PG（需 XHS_CRAWLER_ROOT）
#   xhs-daily-report.timer      — 17:00 PG 生成日报 + zip（会员页展示 18:00）
#   xhs-weekly-report.timer     — 周日 17:00 周报
#   xhs-monthly-report.timer    — 每月1日 17:00 月报
#   xhs-prune-snapshots.timer   — 仅当 RETENTION_DAYS>0 时 03:30 清理快照
#
# 混合模式（本地 gen_report + scp）:
#   xhs-ingest-report.timer     — 20:00 入库

# 报告推云/入库最低条数（与本地 XHS_CLOUD_UPLOAD_MIN_ROWS 对齐，默认 10000）
# 低于此条数拒绝入库，防止残缺报告覆盖完整版；强制上传设 XHS_CLOUD_UPLOAD_FORCE=1 或请求头 X-Upload-Force: 1
XHS_CLOUD_UPLOAD_MIN_ROWS=10000

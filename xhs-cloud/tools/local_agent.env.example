# 本地 risk Agent 配置（复制为 local_agent.env，勿提交 git）
# 服务器 .env 需配置相同 XHS_LOCAL_AGENT_KEY
# 默认 0：不自动拉取云端 risk、不静默后台采集；需开启时改为 1 并安装计划任务

XHS_LOCAL_AGENT_ENABLED=0
XHS_CLOUD_API_URL=https://monitor.xhs365.cn
XHS_LOCAL_AGENT_KEY=请填与服务器一致的长随机串
XHS_LOCAL_AGENT_ID=home-pc-1
XHS_LOCAL_AGENT_BATCH=80
XHS_LOCAL_AGENT_BATCH_MAX=250
XHS_LOCAL_AGENT_CONCURRENCY=6
# 采集模式: api_only(E,推荐) | multi_browser(A) | single_browser(C) | api_then_browser(D)
XHS_LOCAL_AGENT_MODE=api_only
# 三模式对比时每模式测试条数（compare 命令）
XHS_LOCAL_AGENT_COMPARE_N=15
# 有 pending 但本批未拉到工单时的等待
XHS_LOCAL_AGENT_IDLE_SEC=120
# 无工单时轮询间隔（云端补扫时短轮询，不必等整轮冷却）
XHS_LOCAL_AGENT_EMPTY_POLL_SEC=120
XHS_LOCAL_AGENT_COOLDOWN_SEC=60
# 整轮 risk 池扫完后冷却秒数（7200=2小时）
XHS_LOCAL_AGENT_CYCLE_COOLDOWN_SEC=7200
# 只拉距上次扫描≥N小时的 risk（与服务器 claim 一致，避免重复扫）
XHS_LOCAL_AGENT_MIN_AGE_HOURS=2

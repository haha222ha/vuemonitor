# LLM 配置（实验室 .env 示例，勿提交真实 Key）
# 复制为 projects/ai-market-intelligence-v2/.env

# ===== 推荐：PackyAPI + DeepSeek V4 Flash =====
# 1. 在 https://www.packyapi.com 创建令牌，分组选 deepseek-officially
# 2. 填入下方 Key
# 文档：docs/13-LLM-PACKYAPI-DEEPSEEK.md

INSIGHT_LLM_PROVIDER=packy_deepseek
INSIGHT_LLM_API_KEY=
INSIGHT_LLM_BASE_URL=https://www.packyapi.com/v1
INSIGHT_LLM_MODEL=deepseek-v4-flash

# 可与主仓库 server/.env 共用同一 Key 名
# DEEPSEEK_API_KEY=

# CEO Agent 可选更强模型（取消注释）
# INSIGHT_LLM_MODEL_CEO=deepseek-v4-pro

# DeepSeek V4 默认 thinking 开启；Agent JSON 任务建议关闭
INSIGHT_LLM_THINKING=disabled

# 无 Key 或调用失败时降级规则 mock
INSIGHT_LLM_FALLBACK_MOCK=1

# 超时 / 重试
INSIGHT_LLM_TIMEOUT=60
INSIGHT_LLM_MAX_RETRIES=2

# ===== 备选：DeepSeek 官方直连 =====
# INSIGHT_LLM_PROVIDER=deepseek_direct
# INSIGHT_LLM_BASE_URL=https://api.deepseek.com
# INSIGHT_LLM_MODEL=deepseek-v4-flash

# ===== 备选：智谱 GLM =====
# INSIGHT_LLM_PROVIDER=zhipu
# INSIGHT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# INSIGHT_LLM_MODEL=glm-4-flash

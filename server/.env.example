# ============================================================
# XHS365 环境变量配置模板
# 复制此文件为 .env 并修改所有标记为 [必须修改] 的值
# ============================================================

# ===== 应用 =====
APP_NAME=XHS365
APP_VERSION=0.1.0
# [必须修改] 生产环境必须设为 false
DEBUG=true
# [必须修改] 生产环境设为 production
ENVIRONMENT=development

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vuemonitor
DB_USER=saas_user
# [必须修改] 使用 python -c "import secrets; print(secrets.token_urlsafe(24))" 生成
DB_PASSWORD=

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
# [必须修改] 使用 python -c "import secrets; print(secrets.token_urlsafe(24))" 生成
REDIS_PASSWORD=

# ===== JWT 密钥 [必须修改] =====
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 数据加密密钥 [必须修改] =====
# 生成方法: python -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=

# ===== AI 服务（按需配置） =====
AI_DEFAULT_PROVIDER=deepseek
AI_DEFAULT_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ===== 情报系统同步 API Key [必须修改] =====
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 用于 remote_sync 客户端推送数据到服务器的 Bearer Token 认证
INTEL_SYNC_API_KEY=

# ===== 选品会员云（xhs-cloud :8080）=====
# 与 /opt/xhs-cloud/.env 中 XHS_CLOUD_SYNC_KEY 保持一致
XHS_CLOUD_API_URL=http://127.0.0.1:8080
XHS_CLOUD_SYNC_KEY=
# 会员看板链接（发给客户），例如 https://monitor.xhs365.cn/member
XHS_CLOUD_MEMBER_PORTAL_URL=

# ===== 客服（QQ，不依赖 SMTP） =====
SUPPORT_QQ=898382699
SUPPORT_QQ_QR_URL=/support-qq.png
SUPPORT_SITE_URL=https://www.xhs365.cn
SUPPORT_TITLE=QQ 客服
SUPPORT_HINT=注册、授权码、套餐问题请添加 QQ 客服

# ===== 邮件服务（可选，不配则走 QQ 客服） =====
# 网易企业邮示例（netease@yourdomain.com + 客户端授权码，非登录密码）:
# SMTP_HOST=smtp.qiye.163.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# 若 587 失败可试 SSL: SMTP_PORT=994 SMTP_USE_TLS=false SMTP_USE_SSL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ===== CORS =====
# 开发环境允许 localhost，生产环境自动过滤 localhost 来源
# 生产环境请添加实际域名
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","https://www.xhs365.cn","https://xhs365.cn","https://admin.xhs365.cn","https://intel.xhs365.cn"]

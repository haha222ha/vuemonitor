{
  "remote_host": "https://intel.xhs365.cn",
  "api_token": "REDACTED_INTEL_SYNC_KEY",
  "sync_options": {
    "batch_size": 50,
    "retry_count": 3,
    "retry_delay_seconds": 5,
    "timeout_seconds": 60,
    "request_delay_ms": 200
  },
  "targets": {
    "trends": true,
    "signals": true,
    "opportunities": true,
    "risks": true,
    "emotions": true,
    "xhs_topics": true
  },
  "auto_sync": {
    "enabled": true,
    "on_content_complete": true,
    "daily_schedule": ["08:00", "20:00"],
    "use_windows_task": true,
    "runner": "scheduled_sync.ps1"
  },
  "report_upload": {
    "enabled": true,
    "output_root": "AI互联网信息量化/AI内容工厂/output",
    "max_topics": 3,
    "report_type": "weekly"
  },
  "logging": {
    "level": "INFO",
    "log_dir": "logs",
    "max_log_files": 30
  }
}
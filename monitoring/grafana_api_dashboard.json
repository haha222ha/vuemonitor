{
  "dashboard": {
    "title": "XHS365 API Performance",
    "tags": ["xhs365", "api", "performance"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {"from": "now-1h", "to": "now"},
    "panels": [
      {
        "id": 1,
        "title": "Request Rate (req/s)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {"expr": "sum(rate(http_requests_total[5m]))", "legendFormat": "Total"},
          {"expr": "sum(rate(http_requests_total{status=~\"2..\"}[5m]))", "legendFormat": "2xx"},
          {"expr": "sum(rate(http_requests_total{status=~\"4..\"}[5m]))", "legendFormat": "4xx"},
          {"expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx"}
        ]
      },
      {
        "id": 2,
        "title": "Error Rate (%)",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "targets": [
          {"expr": "vuemonitor:http_error_ratio:rate5m * 100", "legendFormat": "Error %"}
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]},
            "unit": "percent",
            "max": 10
          }
        }
      },
      {
        "id": 3,
        "title": "P50 / P95 / P99 Latency",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "targets": [
          {"expr": "vuemonitor:http_latency:p50", "legendFormat": "P50"},
          {"expr": "vuemonitor:http_latency:p95", "legendFormat": "P95"},
          {"expr": "vuemonitor:http_latency:p99", "legendFormat": "P99"}
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 4,
        "title": "DB Connection Pool",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
        "targets": [
          {"expr": "vuemonitor:db_pool_usage_ratio * 100", "legendFormat": "Pool Usage %"}
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]},
            "unit": "percent",
            "max": 100
          }
        }
      },
      {
        "id": 5,
        "title": "DB Pool Details",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 8},
        "targets": [
          {"expr": "db_pool_size", "legendFormat": "Pool Size"},
          {"expr": "db_pool_checked_out", "legendFormat": "Checked Out"},
          {"expr": "db_pool_overflow", "legendFormat": "Overflow"}
        ]
      },
      {
        "id": 6,
        "title": "Process Memory (RSS)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
        "targets": [
          {"expr": "process_memory_rss_bytes", "legendFormat": "RSS"}
        ],
        "fieldConfig": {"defaults": {"unit": "bytes"}}
      },
      {
        "id": 7,
        "title": "Top 10 Slowest Endpoints",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {"expr": "topk(10, histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{path}}", "format": "table"}
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 8,
        "title": "Rate Limited Requests",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {"expr": "rate(http_requests_total{status=\"429\"}[5m])", "legendFormat": "{{path}}"}
        ]
      }
    ]
  },
  "overwrite": true
}
